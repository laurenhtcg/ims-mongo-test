{
  "title": "mongo-bench benchmark collections",
  "description": "Authoritative layout for bench_wildcard, bench_index, and bench_search: collections, MongoDB indexes, and Atlas Search index definitions. Reference this file from test plans and docs; tune field paths when your document shapes are fixed.",
  "schema_version": 1,
  "collections": [
    {
      "name": "bench_wildcard",
      "documentation": "Wildcard MongoDB index for multi-path filters; Atlas Search limited to text-like fields (edit mappings as needed).",
      "indexes": [
        {
          "documentation": "Prefix field sellerKey plus $** wildcard with wildcardProjection (MongoDB compound wildcard index; see https://www.mongodb.com/docs/manual/core/index-wildcard/). Paths align with merge_all product.* and inventory.quantity.",
          "keys": [
            ["sellerKey", 1],
            ["$**", 1]
          ],
          "options": {
            "name": "bench_wildcard_sellerKey_paths",
            "wildcardProjection": {
              "product.productLine": 1,
              "product.set": 1,
              "product.language": 1,
              "product.printing": 1,
              "product.rarity": 1,
              "product.type": 1,
              "inventory.quantity": 1
            }
          }
        }
      ],
      "atlas_search_indexes": [
        {
          "name": "bench_text",
          "documentation": "Search on explicit text fields; nested product uses type document (dynamic false).",
          "definition": {
            "mappings": {
              "dynamic": false,
              "fields": {
                "sellerKey": [
                  {
                    "type": "token",
                    "normalizer": "lowercase"
                  }
                ],
                "product": {
                  "type": "document",
                  "fields": {
                    "name": [
                      {
                        "type": "string",
                        "analyzer": "lucene.standard"
                      },
                      {
                        "type": "token",
                        "normalizer": "lowercase"
                      },
                      {
                        "type": "autocomplete",
                        "tokenization": "nGram",
                        "minGrams": 2,
                        "maxGrams": 15,
                        "foldDiacritics": true
                      }
                    ],
                    "productLine": [
                      {
                        "type": "string",
                        "analyzer": "lucene.standard"
                      },
                      {
                        "type": "token",
                        "normalizer": "lowercase"
                      },
                      {
                        "type": "autocomplete",
                        "tokenization": "nGram",
                        "minGrams": 2,
                        "maxGrams": 15,
                        "foldDiacritics": true
                      }
                    ],
                    "set": [
                      {
                        "type": "string",
                        "analyzer": "lucene.standard"
                      },
                      {
                        "type": "token",
                        "normalizer": "lowercase"
                      },
                      {
                        "type": "autocomplete",
                        "tokenization": "nGram",
                        "minGrams": 2,
                        "maxGrams": 15,
                        "foldDiacritics": true
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "bench_index",
      "documentation": "Compound MongoDB index for selective scans; Atlas Search on text fields only.",
      "indexes": [
        {
          "documentation": "Compound index for typical filter + sort patterns (adjust fields to match seeded data).",
          "keys": [
            ["sellerKey", 1],
            ["product.productLine", 1],
            ["product.set", 1],
            ["product.language", 1],
            ["product.printing", 1],
            ["product.rarity", 1],
            ["product.type", 1],
            ["inventory.quantity", 1]
          ],
          "options": {
            "name": "bench_compound"
          }
        }
      ],
      "atlas_search_indexes": [
        {
          "name": "bench_text",
          "documentation": "Text search on selected string fields; nested product uses type document (dynamic false).",
          "definition": {
            "mappings": {
              "dynamic": false,
              "fields": {
                "sellerKey": [
                  {
                    "type": "token",
                    "normalizer": "lowercase"
                  }
                ],
                "product": {
                  "type": "document",
                  "fields": {
                    "name": [
                      {
                        "type": "string",
                        "analyzer": "lucene.standard"
                      },
                      {
                        "type": "token",
                        "normalizer": "lowercase"
                      },
                      {
                        "type": "autocomplete",
                        "tokenization": "nGram",
                        "minGrams": 2,
                        "maxGrams": 15,
                        "foldDiacritics": true
                      }
                    ],
                    "productLine": [
                      {
                        "type": "string",
                        "analyzer": "lucene.standard"
                      },
                      {
                        "type": "token",
                        "normalizer": "lowercase"
                      },
                      {
                        "type": "autocomplete",
                        "tokenization": "nGram",
                        "minGrams": 2,
                        "maxGrams": 15,
                        "foldDiacritics": true
                      }
                    ],
                    "set": [
                      {
                        "type": "string",
                        "analyzer": "lucene.standard"
                      },
                      {
                        "type": "token",
                        "normalizer": "lowercase"
                      },
                      {
                        "type": "autocomplete",
                        "tokenization": "nGram",
                        "minGrams": 2,
                        "maxGrams": 15,
                        "foldDiacritics": true
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "bench_search",
      "documentation": "No collection-level indexes; Atlas Search with explicit mappings (dynamic false) aligned to merge_all bench document shape.",
      "indexes": [],
      "atlas_search_indexes": [
        {
          "name": "bench_search_index",
          "documentation": "Nested product/inventory use type document so paths like product.productLine index correctly under dynamic false; productLine and set use token plus lucene.keyword for equals/in (not lucene.standard alone).",
          "definition": {
            "mappings": {
              "dynamic": false,
              "fields": {
                "pamKey": [
                  {
                    "type": "token"
                  }
                ],
                "sellerKey": [
                  {
                    "type": "token"
                  }
                ],
                "inventory": {
                  "type": "document",
                  "fields": {
                    "lastUpdated": [
                      {
                        "type": "date"
                      }
                    ],
                    "quantity": [
                      {
                        "type": "number"
                      }
                    ],
                    "reserveQuantity": [
                      {
                        "type": "number"
                      }
                    ]
                  }
                },
                "product": {
                  "type": "document",
                  "fields": {
                    "cardNumber": [
                      {
                        "type": "token",
                        "normalizer": "lowercase"
                      }
                    ],
                    "language": [
                      {
                        "type": "token",
                        "normalizer": "lowercase"
                      }
                    ],
                    "name": [
                      {
                        "type": "token"
                      },
                      {
                        "type": "string",
                        "analyzer": "lucene.standard"
                      },
                      {
                        "type": "autocomplete",
                        "tokenization": "nGram",
                        "minGrams": 2,
                        "maxGrams": 15,
                        "foldDiacritics": true
                      }
                    ],
                    "printing": [
                      {
                        "type": "token",
                        "normalizer": "lowercase"
                      }
                    ],
                    "productLine": [
                      {
                        "type": "token"
                      },
                      {
                        "type": "string",
                        "analyzer": "lucene.keyword",
                        "searchAnalyzer": "lucene.keyword"
                      }
                    ],
                    "rarity": [
                      {
                        "type": "token"
                      }
                    ],
                    "set": [
                      {
                        "type": "token"
                      },
                      {
                        "type": "string",
                        "analyzer": "lucene.keyword",
                        "searchAnalyzer": "lucene.keyword"
                      }
                    ],
                    "type": [
                      {
                        "type": "token",
                        "normalizer": "lowercase"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    }
  ]
}