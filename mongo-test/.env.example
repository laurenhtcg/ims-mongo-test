# Copy to .env and adjust if needed (do not commit real secrets).
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=mongo_bench

# Skip Atlas Search index creation (1/true/yes) when not on Atlas 7.0+.
MONGO_BENCH_SKIP_SEARCH_INDEXES=0

# --- Docker Compose (optional)
# When you run ``docker compose`` from this directory, Compose loads this file for
# ${VAR} substitution in docker-compose.yml. Use the same names as above.
# For an external sandbox DB, set MONGODB_URI here and use ``docker compose run --no-deps …``.

# search_index benchmark (optional)
# BENCH_QUANTITY_MIN_PROB=0.4

# Optional: absolute path to an env file (otherwise .env is loaded from cwd / project root).
# MONGO_BENCH_DOTENV=
